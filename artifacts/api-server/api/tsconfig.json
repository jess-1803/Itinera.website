{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": ".",
    "rootDir": ".",
    "types": ["node", "express"]
  },
  "include": ["index.ts"],
  "references": [{ "path": "../tsconfig.json" }]
}
